# ============================================================
# EA AI PLATFORM — Environment Configuration
# Copy this file to backend/.env (same folder as backend/requirements.txt)
#   Windows (repo root):  copy .env.example backend\.env
#   Linux/Mac:            cp .env.example backend/.env
# Then edit backend/.env with your API keys and paths.
# NEVER commit .env or backend/.env to version control.
# Paths like ./storage/... are relative to the backend/ working directory.
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key-64-chars
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default for MVP)
DATABASE_URL=sqlite:///./storage/ea_platform.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/ea_platform

# --- Storage ---
UPLOAD_DIR=./storage/uploads
REPORTS_DIR=./storage/reports
VERSIONS_DIR=./storage/strategy_versions
MAX_UPLOAD_SIZE_MB=50

# --- LLM Provider ---
# Options: openai | anthropic | openai_compatible | gemini
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# Google Gemini (https://aistudio.google.com/apikey) — backend reads GEMINI_* from OS env (incl. backend/.env via python-dotenv)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=8192

# OpenAI-compatible local (e.g. Ollama, LM Studio)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_API_KEY=ollama

# Vision model for screenshot analysis (OpenAI / Anthropic id, or gemini-* when LLM_PROVIDER=gemini)
VISION_MODEL=gpt-4o
# If using Anthropic for vision:
# VISION_MODEL=claude-3-5-sonnet-20241022
# If using Gemini for everything (default vision follows GEMINI_MODEL if VISION_MODEL is not gemini-*):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-ai-studio-key
# VISION_MODEL=gemini-2.0-flash

# --- MT5 Integration ---
# Path to MetaTrader5 terminal (Windows only)
MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_ACCOUNT=0
MT5_PASSWORD=
MT5_SERVER=

# MT5 data directory (for reading logs)
MT5_DATA_DIR=C:/Users/YOUR_USER/AppData/Roaming/MetaQuotes/Terminal/YOUR_TERMINAL_ID

# --- LIVE TRADING — DISABLED BY DEFAULT ---
# This MUST remain false unless you have completed demo validation
ENABLE_LIVE_TRADING=false

# Risk controls (apply to both demo and live)
MAX_DAILY_LOSS_USD=100.0
MAX_WEEKLY_LOSS_USD=300.0
MAX_DRAWDOWN_PERCENT=10.0
MAX_LOT_SIZE=0.10
MAX_TRADES_PER_DAY=5
MAX_OPEN_TRADES=2
MAX_CONSECUTIVE_LOSSES=3
SPREAD_FILTER_PIPS=3.0
SLIPPAGE_FILTER_PIPS=2.0

# Allowed symbols (comma-separated, empty = all)
SYMBOL_WHITELIST=XAUUSD,EURUSD,GBPUSD

# Allowed sessions (comma-separated)
SESSION_WHITELIST=london,new_york,london_new_york_overlap

# --- TradingView ---
# Do NOT store credentials here — use OAuth if needed
TRADINGVIEW_WEBHOOK_SECRET=your-webhook-secret-here

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- Celery / Background Tasks ---
# For MVP, use in-process background tasks (no Celery needed)
# For production, configure Redis:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- External SMC knowledge (Word) ---
# Absolute path to your reference .docx (used in TradingView compare + screenshot prompts + mock text)
# Example (Windows):
# SMC_KNOWLEDGE_DOCX_PATH=C:/Users/you/OneDrive/.../AI TRADING KNOWLEDGE REFERENCE.docx
SMC_KNOWLEDGE_DOCX_PATH=
SMC_KNOWLEDGE_MAX_CHARS=12000

# --- Mock Mode ---
# MOCK_MODE=false and MOCK_LLM=false + valid API key → real LLM + real MT5 when MetaTrader5 is installed
# MOCK_MODE=true → MT5 bridge uses mock data; MOCK_LLM=true → no API calls (stub responses)
MOCK_MODE=false
MOCK_LLM=false

# --- Pending Order Lock / OB Learning Observations ---
# Lock first valid setup and never chase pending entries.
SMC_PENDING_ORDER_LOCK=true
SMC_ALLOW_PENDING_REPLACE=false
SMC_LOG_NEW_OB_AFTER_SIGNAL=true
SMC_LOG_HYPOTHETICAL_OB_OUTCOMES=true

# --- OB timeframe preference (M15 vs M5) ---
# m15_then_m5  → always pick M15 OB if present (more SL buffer, default)
# m5_then_m15  → tight M5 entry first, fall back to M15
# most_recent  → legacy: whichever OB formed last in time (almost always M5)
SMC_OB_TIMEFRAME_PREFERENCE=m15_then_m5

# --- Premium / discount classification ---
# strict  → only deep ends count: premium >= SMC_PREMIUM_FIB, discount <= SMC_DISCOUNT_FIB
# classic → legacy 50% split with neutral band (SMC_EQ_NEUTRAL_BAND)
SMC_LOCATION_MODE=strict
SMC_PREMIUM_FIB=0.618
SMC_DISCOUNT_FIB=0.382
SMC_EQ_NEUTRAL_BAND=0.03
