[Unit]
Description=EA AI Platform FastAPI Backend
After=network-online.target ea-ollama.service
Wants=network-online.target ea-ollama.service

[Service]
Type=simple
WorkingDirectory=/opt/ea-ai-platform/backend
EnvironmentFile=/opt/ea-ai-platform/backend/.env
ExecStart=/opt/ea-ai-platform/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
