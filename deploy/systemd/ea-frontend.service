[Unit]
Description=EA AI Platform Next.js Frontend
After=network-online.target ea-backend.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ea-ai-platform/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
